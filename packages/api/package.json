{
  "name": "@dp/api",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --watch src/main.ts",
    "start": "node --experimental-strip-types src/start.ts",
    "seed": "node --experimental-strip-types src/seedDb.ts",
    "backup": "node --experimental-strip-types src/backup.ts",
    "restore": "node --experimental-strip-types src/restore.ts",
    "test": "node --experimental-strip-types --test src/__tests__/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@dp/shared-rules": "*",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.1"
  }
}
