# Supabase project. Both of these are PUBLIC — they ship in the client bundle.
# The anon key grants nothing on its own: every capability behind it is gated
# by row level security.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# NEVER put the service role key here, in any VITE_ variable, or anywhere else
# the browser can reach. It bypasses all RLS, which is the entire security
# model. It belongs only in Edge Function secrets.

# With neither variable set, the app runs against the in-memory mock backend.
